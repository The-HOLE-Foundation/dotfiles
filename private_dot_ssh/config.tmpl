# =============================================================================
# NetBird overlay — durable, location-independent identities (#58, ADR-002)
# =============================================================================
# Every homelab peer is reachable as <name>.netbird.hole over the NetBird
# overlay — the only identities that work off-LAN. A connection to a
# *.netbird.hole name rides *inside* the WireGuard tunnel to that specific
# peer, so the transport is already cryptographically bound to that peer:
# SSH host-key pinning adds nothing here. NetBird's built-in SSH server also
# manages its own host keys, which rotate with the NetBird version (observed:
# pve's key changed across NetBird 0.74→0.75), so pinning them in known_hosts
# only produces spurious "host key changed" warnings.
#
# Hence `accept-new` against /dev/null: no first-connect prompt, no stale-key
# churn, trust delegated to the overlay. This one wildcard makes any current
# or future peer born-connectable with zero per-host maintenance — the `-nb`
# blocks below are just convenience shorthands that also set the login user.
# (Expect a harmless "Permanently added … to the list of known hosts" line;
# /dev/null never persists, which is what keeps rotation from ever erroring.)
Host *.netbird.hole *-nb
	StrictHostKeyChecking accept-new
	UserKnownHostsFile /dev/null
	ForwardAgent no

Host pve-nb
	HostName pve.netbird.hole
	User root

Host macstudio-nb
	HostName macstudio.netbird.hole
	User jth

Host mac-mini-nb
	HostName jth-mac-mini.netbird.hole
	User jth

# =============================================================================
# Homelab — LAN-first; tailscale aliases are fallbacks
# Documentation: ~/.local/share/infra/
# =============================================================================

# --- Proxmox hypervisor (root-only by design) ---
Host pve proxmox
	HostName 192.168.68.16
	User root
	IdentityFile ~/.ssh/id_ed25519_pve
	IdentitiesOnly yes
	PreferredAuthentications publickey,password,keyboard-interactive
	ForwardAgent no
	UserKnownHostsFile ~/.ssh/known_hosts

# Tailscale fallback for PVE (off-LAN only; node not yet joined as of 2026-05-20)
Host pve-ts
	HostName ts-pve
	User root
	IdentityFile ~/.ssh/id_ed25519_pve
	IdentitiesOnly yes
	UserKnownHostsFile ~/.ssh/known_hosts_tailnet

# --- PVE admin LXC (CTID 100, jth, key-only) ---
Host pve-admin
	HostName 192.168.68.60
	User jth
	IdentityFile ~/.ssh/id_ed25519_pve_admin
	IdentitiesOnly yes
	PreferredAuthentications publickey
	ForwardAgent no
	ServerAliveInterval 30
	UserKnownHostsFile ~/.ssh/known_hosts

# --- dev-control VM (Coder + Docker + Postgres) ---
# Pending VM build — see docs/personal-codespaces.md
# Key id_ed25519_dev_control lands in the follow-up PR that actually builds the VM
Host dev-control
	HostName 192.168.68.20
	User jth
	IdentityFile ~/.ssh/id_ed25519_dev_control
	IdentitiesOnly yes
	PreferredAuthentications publickey
	ForwardAgent no
	ServerAliveInterval 30
	UserKnownHostsFile ~/.ssh/known_hosts

# --- Mac Studio workstation ---
Host macstudio jth-macstudio
	HostName 10.0.0.13
	User jth
	IdentityFile ~/.ssh/id_ed25519_macstudio
	IdentitiesOnly yes
	PreferredAuthentications publickey,password,keyboard-interactive
	ForwardAgent no
	ServerAliveInterval 30
	ServerAliveCountMax 6
	UserKnownHostsFile ~/.ssh/known_hosts

# Tailscale fallback for Mac Studio (off-LAN only)
Host macstudio-ts
	HostName jth-macstudio
	User jth
	IdentityFile ~/.ssh/id_ed25519_macstudio
	IdentitiesOnly yes
	UserKnownHostsFile ~/.ssh/known_hosts_tailnet

