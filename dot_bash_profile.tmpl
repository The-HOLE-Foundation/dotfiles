# Homebrew — bash LOGIN shells (ssh, `bash -l`, console logins). bash reads
# .bash_profile instead of .bashrc here, so the snippet has to be in both.
# On macOS this deliberately runs after /etc/profile's path_helper, which would
# otherwise push the brew prefix behind /usr/bin.
{{ template "brew-shellenv" . }}
# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
if [ -f "$HOME/micromamba/bin/conda" ]; then
    __conda_setup="$("$HOME/micromamba/bin/conda" 'shell.bash' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    elif [ -f "$HOME/micromamba/etc/profile.d/conda.sh" ]; then
        . "$HOME/micromamba/etc/profile.d/conda.sh"
    fi
    unset __conda_setup
elif [ -f "$HOME/micromamba/etc/profile.d/conda.sh" ]; then
    . "$HOME/micromamba/etc/profile.d/conda.sh"
elif [ -d "$HOME/micromamba/bin" ]; then
    # Guard the fallback: the original prepended this unconditionally, putting a
    # nonexistent dir at the front of PATH on every machine without micromamba
    # (see scripts/test-profile.sh:296).
    export PATH="$HOME/micromamba/bin:$PATH"
fi
# <<< conda initialize <<<

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
