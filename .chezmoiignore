# Skip age-encrypted files when the recipient's private key isn't bootstrapped.
# Include both target paths and source paths for safety across chezmoi contexts.
# (Some flows evaluate ignore rules against target paths, others against source names.)
# Without this, `chezmoi apply` fails on fresh VMs / test rigs that don't yet
# have ~/.config/chezmoi/key.txt — even though these files are not load-bearing
# for the rest of the deploy.
{{- if not (stat (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt")) }}
.local/share/infra/**
.ssh/id_ed25519_pve_admin
.ssh/id_ed25519_macstudio
.ssh/id_ed25519_pve
dot_local/private_share/infra/encrypted_README.md.age
dot_local/private_share/infra/encrypted_proxmox.md.age
private_dot_ssh/encrypted_private_id_ed25519_macstudio.age
private_dot_ssh/encrypted_private_id_ed25519_pve.age
private_dot_ssh/encrypted_private_id_ed25519_pve_admin.age
{{- end }}
