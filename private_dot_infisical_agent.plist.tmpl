<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Infisical Agent LaunchAgent — persistent daemon on macOS.

  Decrypts credentials from age-encrypted files, then starts the agent
  to continuously render secrets into ~/.infisical/.

  Install (after chezmoi apply):
    ln -sf ~/dotfiles/private_dot_infisical_agent.plist \
      ~/Library/LaunchAgents/com.infisical.agent.plist
    launchctl load ~/Library/LaunchAgents/com.infisical.agent.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.infisical.agent.plist
    rm ~/Library/LaunchAgents/com.infisical.agent.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.infisical.agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.local/bin/infisical</string>
    <string>agent</string>
    <string>--config</string>
    <string>{{ .chezmoi.homeDir }}/.config/infisical/agent-config.yaml</string>
  </array>

  <key>EnvironmentVariables</key>
  <plist version="1.0">
<dict>
    <key>INFISICAL_ADDRESS</key>
    <string>https://app.infisical.com</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <plist version="1.0">
<dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/logs/infisical-agent.log</string>

  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/logs/infisical-agent.log</string>

  <key>WatchPaths</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.config/infisical/agent-config.yaml</string>
  </array>
</dict>
</plist>
