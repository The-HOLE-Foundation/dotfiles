#!/bin/bash
# Install packages from Brewfile (runs AFTER files are deployed so Brewfiles exist)
#
# Philosophy: chezmoi only auto-installs the CORE set. Anything else you want
# on a given machine, install manually with `brew install`. `brew bundle` does
# not remove unlisted packages, so your machine-specific installs stay put.
#
# On Alpine/musl, Homebrew is not available — we fall back to apk.
# On all other Linux distributions (Debian, RHEL, etc.) Homebrew is used.
set -e

# ── OS family detection ───────────────────────────────────────────────────────
# Used to decide whether to fall back to a native package manager.
_os_family() {
  if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    case "${ID:-}" in
      alpine)                           echo "alpine"; return ;;
      ubuntu|debian|linuxmint|pop|kali) echo "debian"; return ;;
      rhel|centos|fedora|rocky|almalinux|ol|scientific) echo "rhel"; return ;;
    esac
    case "${ID_LIKE:-}" in
      *debian*)                 echo "debian"; return ;;
      *rhel*|*fedora*|*centos*) echo "rhel";   return ;;
    esac
  fi
  echo "unknown"
}
OS_FAMILY="$(_os_family)"

# ── Ensure brew is on PATH ────────────────────────────────────────────────────
# Don't swallow stderr — if shellenv fails we want to know.
{{- if eq .chezmoi.os "darwin" }}
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
{{- else }}
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
{{- end }}

if ! command -v brew >/dev/null 2>&1; then
  if [[ "$OS_FAMILY" == "alpine" ]]; then
    # Alpine/musl: Homebrew is not supported. Install equivalent tools via apk
    # from the community repository (enabled by run_once_before_00-linux-bootstrap).
    echo "→ Alpine detected — installing core tools via apk instead of Homebrew..."
    APK_CORE_PACKAGES=(
      age            # file encryption (chezmoi secrets)
      bat            # cat replacement
      direnv         # per-project env vars
      eza            # ls replacement
      fd             # find replacement
      fzf            # fuzzy finder
      go             # Go toolchain
      helix          # text editor
      jq             # JSON processor
      nnn            # file manager
      ripgrep        # grep replacement
      zsh            # login shell
    )
    sudo apk add --no-cache "${APK_CORE_PACKAGES[@]}" || {
      echo "  ⚠ Some apk packages may not be available in this Alpine version — continuing"
    }
    # Tools not available in apk (doppler, fnm, gh, lazygit, lazyssh, uv,
    # git-filter-repo, pyenv, powerlevel10k) are left for manual install.
    echo "  ℹ doppler, fnm, gh, lazygit, uv, and pyenv are not in apk."
    echo "    Install them manually from their upstream binary releases."
    echo "→ apk core install complete"
  else
    echo "✗ brew not on PATH after shellenv (OS family: ${OS_FAMILY}) — aborting Brewfile install"
    exit 1
  fi
else
  # Cross-platform core Brewfile (Debian, RHEL, macOS).
  # Note: `brew bundle` without a subcommand prints help; the install action
  # requires the explicit `install` subcommand on current Homebrew.
  if [[ -f "$HOME/.Brewfile.core" ]]; then
    echo "→ Installing core packages from ~/.Brewfile.core..."
    brew bundle install --file="$HOME/.Brewfile.core"
  fi
fi

# ── Per-project Brewfiles ───────────────────────────────────────────────────
# Driven by the `projects` list in ~/.config/chezmoi/chezmoi.toml. The list
# is expanded at apply time by chezmoi templating, so the rendered script
# contains one literal block per active profile. File presence drives
# installation — a key without a matching ~/.Brewfile.<key> is a no-op.
# Alpine: skip per-project Brewfiles (brew is not installed).
if command -v brew >/dev/null 2>&1; then
  :
{{ range .projects }}
  if [[ -f "$HOME/.Brewfile.{{ . }}" ]]; then
    echo "→ Installing {{ . }} packages from ~/.Brewfile.{{ . }}..."
    brew bundle install --file="$HOME/.Brewfile.{{ . }}"
  fi
{{ end }}
fi

# ── Node + Claude Code (cross-platform, needs fnm from brew) ────────────────
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell bash)"
  if ! command -v node >/dev/null 2>&1; then
    echo "→ Installing Node LTS..."
    fnm install --lts
    fnm default lts-latest
    echo "✓ Node installed ($(node --version))"
  fi

  if ! npm list -g --depth=0 @anthropic-ai/claude-code >/dev/null 2>&1; then
    echo "→ Installing Claude Code..."
    npm install -g @anthropic-ai/claude-code
    echo "✓ Claude Code installed"
  else
    echo "✓ Claude Code already installed"
  fi
fi
