#!/bin/bash
# godocs profile — hole-godocs setup
# https://github.com/the-hole-foundation/hole-godocs
#
# Self-gates on the `projects` list in ~/.config/chezmoi/chezmoi.toml
# containing "godocs". On a fresh machine without the key, the rendered
# script is just the shebang + `exit 0` and does nothing.
#
# This script intentionally does NOT clone the project repo and does NOT
# run any command that needs an interactive browser (no `aws sso login`,
# no `gh auth login`). It will configure the rclone R2 remote
# non-interactively if Doppler has the creds; otherwise it prints a
# banner with the manual next steps.
{{- if not (has "godocs" .projects) }}
exit 0
{{- else }}
set -euo pipefail

echo "→ Configuring 'godocs' project profile..."

# ── LibreOffice headless ────────────────────────────────────────────────────
# LibreOffice is not in dot_Brewfile.godocs because Linuxbrew has no
# libreoffice formula and Homebrew Cask is macOS-only. We install it here
# with an explicit platform branch instead, so the Brewfile stays portable.
{{- if eq .chezmoi.os "darwin" }}
if ! command -v soffice >/dev/null 2>&1 \
   && [[ ! -d "/Applications/LibreOffice.app" ]]; then
  echo "→ Installing LibreOffice (cask)..."
  brew install --cask libreoffice
else
  echo "✓ LibreOffice already installed"
fi
{{- else }}
if ! command -v soffice >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    echo "→ Installing libreoffice via apt (headless usage by hole-godocs)..."
    sudo DEBIAN_FRONTEND=noninteractive apt-get update -qq
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
      libreoffice --no-install-recommends
  else
    echo "⚠ libreoffice not on PATH and no apt-get; install manually."
  fi
else
  echo "✓ LibreOffice already installed"
fi
{{- end }}

# ── go@1.25 PATH wiring ─────────────────────────────────────────────────────
# `go@1.25` is keg-only in Homebrew, so the binary isn't on PATH by default.
# Drop a tiny shim into ~/.zshrc.d so any new shell picks it up. The shim
# only fires when go@1.25 is actually installed AND the project key is set,
# so a machine without the godocs profile still gets the unversioned `go`
# from dot_Brewfile.core.
SHIM_DIR="$HOME/.zshrc.d"
SHIM_FILE="$SHIM_DIR/godocs-go125.zsh"
mkdir -p "$SHIM_DIR"
cat > "$SHIM_FILE" <<'SHIM'
# Auto-generated by run_once_after_install-project-godocs.sh.tmpl.
# Prepends Homebrew's keg-only go@1.25 to PATH so it shadows the default
# `go` in core. Safe no-op when go@1.25 isn't installed.
if command -v brew >/dev/null 2>&1; then
  _go125_prefix="$(brew --prefix go@1.25 2>/dev/null || true)"
  if [[ -n "$_go125_prefix" && -x "$_go125_prefix/bin/go" ]]; then
    export PATH="$_go125_prefix/bin:$PATH"
  fi
  unset _go125_prefix
fi
SHIM
echo "✓ go@1.25 PATH shim → $SHIM_FILE"

# ── rclone R2 remote (non-interactive when Doppler creds are present) ──────
# Reads R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_ACCOUNT_ID from the
# Doppler scope identified by DOPPLER_GODOCS_PROJECT / DOPPLER_GODOCS_CONFIG
# (defaults: project=godocs, config=dev). If Doppler isn't logged in or the
# secrets aren't there, we skip silently and rely on the banner at the end.
RCLONE_CONF="$HOME/.config/rclone/rclone.conf"
DOPPLER_GODOCS_PROJECT="${DOPPLER_GODOCS_PROJECT:-godocs}"
DOPPLER_GODOCS_CONFIG="${DOPPLER_GODOCS_CONFIG:-dev}"

write_r2_remote() {
  local access_key="$1" secret_key="$2" account_id="$3"
  mkdir -p "$(dirname "$RCLONE_CONF")"
  if [[ -f "$RCLONE_CONF" ]] && grep -q '^\[r2\]' "$RCLONE_CONF"; then
    echo "✓ rclone [r2] remote already present in $RCLONE_CONF — leaving alone"
    return 0
  fi
  cat >> "$RCLONE_CONF" <<RCLONE_R2
[r2]
type = s3
provider = Cloudflare
access_key_id = ${access_key}
secret_access_key = ${secret_key}
endpoint = https://${account_id}.r2.cloudflarestorage.com
acl = private
no_check_bucket = true
RCLONE_R2
  chmod 600 "$RCLONE_CONF"
  echo "✓ Wrote rclone [r2] remote → $RCLONE_CONF"
}

R2_CONFIGURED=0
if command -v rclone >/dev/null 2>&1; then
  # Try Infisical Agent rendered file first (preferred).
  R2_CONF="{{ .chezmoi.homeDir }}/.infisical/godocs-secrets.env"
  if [[ -f "$R2_CONF" ]]; then
    # shellcheck disable=SC1090
    . "$R2_CONF"
    if [[ -n "${R2_ACCESS_KEY_ID:-}" && -n "${R2_SECRET_ACCESS_KEY:-}" && -n "${R2_ACCOUNT_ID:-}" ]]; then
      write_r2_remote "$R2_ACCESS_KEY_ID" "$R2_SECRET_ACCESS_KEY" "$R2_ACCOUNT_ID"
      R2_CONFIGURED=1
    fi
  fi

  # Fall back to Infisical CLI.
  if [[ "$R2_CONFIGURED" -eq 0 ]] && command -v infisical &>/dev/null; then
    eval "$(infisical run --env=dev --path=/ --projectId=<godocs-project-id> \
      -- sh -c 'printf "R2_ACCESS_KEY_ID=%s\nR2_SECRET_ACCESS_KEY=%s\nR2_ACCOUNT_ID=%s" "$R2_ACCESS_KEY_ID" "$R2_SECRET_ACCESS_KEY" "$R2_ACCOUNT_ID"' 2>/dev/null)" || true
    if [[ -n "${R2_ACCESS_KEY_ID:-}" && -n "${R2_SECRET_ACCESS_KEY:-}" && -n "${R2_ACCOUNT_ID:-}" ]]; then
      write_r2_remote "$R2_ACCESS_KEY_ID" "$R2_SECRET_ACCESS_KEY" "$R2_ACCOUNT_ID"
      R2_CONFIGURED=1
    fi
  fi

  # Ultimate fallback: Doppler (legacy).
  if [[ "$R2_CONFIGURED" -eq 0 ]] && command -v doppler &>/dev/null; then
    R2_AKID="$(doppler secrets get R2_ACCESS_KEY_ID --plain \
                --project "$DOPPLER_GODOCS_PROJECT" \
                --config "$DOPPLER_GODOCS_CONFIG" 2>/dev/null || true)"
    R2_SECRET="$(doppler secrets get R2_SECRET_ACCESS_KEY --plain \
                --project "$DOPPLER_GODOCS_PROJECT" \
                --config "$DOPPLER_GODOCS_CONFIG" 2>/dev/null || true)"
    R2_ACCT="$(doppler secrets get R2_ACCOUNT_ID --plain \
               --project "$DOPPLER_GODOCS_PROJECT" \
               --config "$DOPPLER_GODOCS_CONFIG" 2>/dev/null || true)"
    if [[ -n "$R2_AKID" && -n "$R2_SECRET" && -n "$R2_ACCT" ]]; then
      write_r2_remote "$R2_AKID" "$R2_SECRET" "$R2_ACCT"
      R2_CONFIGURED=1
    fi
  fi
fi

if [[ "$R2_CONFIGURED" -eq 0 ]]; then
  echo "→ Skipping rclone R2 configuration (Infisical/Doppler creds not available)."
fi
fi

cat <<'BANNER'

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  godocs profile installed.

  Next steps (run manually — fresh hosts have no creds yet):

    1. Authenticate to Infisical so R2 / AWS secrets are available:
         infisical login --method=universal-auth --client-id=<id> --client-secret=<secret>
       Then re-run this script (it is idempotent) to write the rclone
       remote if it wasn't configured above:
         chezmoi apply --include=scripts

    2. Clone hole-godocs and verify the Go toolchain:
         git clone git@github.com:the-hole-foundation/hole-godocs.git \
           ~/src/hole-godocs
         cd ~/src/hole-godocs
         go version          # should report go1.25.x
         go build ./...

    3. Sanity-check the doc-extraction pipeline:
         bash test-mupdf.sh
         soffice --headless --version

    4. (Optional) Verify R2 reachability once Infisical creds are loaded:
         rclone lsd r2:

  See ~/dotfiles/docs/profiles/godocs.md for the full reference.
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
BANNER
{{- end }}
