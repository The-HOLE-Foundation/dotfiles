#!/bin/bash
# pipefail so `npm install … | tail -3` style pipes can't mask non-zero exits
# from the actual installer. `set -u` catches accidental unset-var typos.
set -euo pipefail

# ══════════════════════════════════════════════════════════════════════════════
# Toolchains — cross-platform
#
# Runs AFTER the Brewfile.core install (lexically `install-brewfile` < `install-toolchains`),
# so the static binaries this script initializes (fnm, supabase tap) are
# already on PATH via brew.
#
# Alpine/musl note: Homebrew is not available on Alpine. Brew-dependent steps
# are skipped; Rust via rustup-init still works (Alpine provides musl targets).
# ══════════════════════════════════════════════════════════════════════════════

IS_ALPINE=false
command -v apk >/dev/null 2>&1 && IS_ALPINE=true

# Ensure brew is on PATH (non-Alpine only)
if [[ "$IS_ALPINE" == "false" ]]; then
{{- if eq .chezmoi.os "darwin" }}
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
{{- else }}
  if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  fi
{{- end }}
fi

# Rust: install via official rustup-init script. We deliberately don't use
# `brew install rustup` because Linuxbrew ships only the `rustup` binary
# without ~/.cargo/bin proxies for `cargo` / `rustc`; the upstream installer
# does it right on both macOS and Linux. .zshrc already sources ~/.cargo/env.
if [[ ! -f "$HOME/.cargo/env" ]]; then
  echo "→ Installing Rust via the official rustup-init script..."
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --default-toolchain stable
fi
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# Node via fnm (fnm itself is in Brewfile.core)
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell bash)" 2>/dev/null || true
  if ! command -v node >/dev/null 2>&1; then
    echo "→ Installing Node LTS via fnm..."
    fnm install --lts
    fnm default lts-latest
  fi
fi

# npm globals (cross-platform tools we want everywhere)
if command -v npm >/dev/null 2>&1; then
  NPM_TOOLS=(
    "@anthropic-ai/claude-code"
    "wrangler"
    "ctx7"
    "@mem0/cli"
  )
  for pkg in "${NPM_TOOLS[@]}"; do
    if ! npm list -g --depth=0 "$pkg" >/dev/null 2>&1; then
      echo "→ Installing $pkg..."
      npm install -g "$pkg"
    fi
  done
fi

# Supabase CLI via brew tap (not in core Brewfile because it needs a tap).
# Skipped on Alpine/musl where brew is not available.
if [[ "$IS_ALPINE" == "false" ]] && ! command -v supabase >/dev/null 2>&1 && command -v brew >/dev/null 2>&1; then
  echo "→ Installing Supabase CLI..."
  brew install supabase/tap/supabase
fi
