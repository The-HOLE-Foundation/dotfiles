#!/bin/bash
set -e

# ══════════════════════════════════════════════════════════════════════════════
# Tailscale — cross-platform
# Runs early (BEFORE phase) so the rest of the bootstrap has network identity.
# ══════════════════════════════════════════════════════════════════════════════

# Installing/administering a system VPN daemon needs privilege. A sudo-less
# agent-space (#99) skips this entirely — networking is the provisioning phase's
# job. (Tailscale is also being retired in favour of Netbird per ADR-002.)
if [ "$(id -u)" -ne 0 ] && ! { command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; }; then
  echo "→ Unprivileged agent-space — skipping Tailscale install/setup"
  exit 0
fi

if ! command -v tailscale &>/dev/null; then
{{- if eq .chezmoi.os "darwin" }}
  echo "→ Tailscale: install via 'brew install --cask tailscale' or Brewfile"
{{- else }}
  echo "→ Installing Tailscale..."
  curl -fsSL https://tailscale.com/install.sh | sh
  echo "✓ Tailscale installed"
{{- end }}
fi

{{- if ne .chezmoi.os "darwin" }}
# On Linux, start tailscaled and join the tailnet if an auth key is available.
# Project's server-tag auth key lives at backend/dev, secret name TAILSCALE_AUTHKEY_SERVER.
if command -v tailscale &>/dev/null; then
  if ! tailscale status &>/dev/null; then
    sudo systemctl enable --now tailscaled 2>/dev/null || true
{{- if or (lookPath "infisical") (.fileExists (joinPath .chezmoi.homeDir ".infisical/tailscale-authkey.txt")) }}
    # Try Infisical Agent rendered file first (preferred), then fall back to CLI.
    TS_AUTHKEY=""
    if [ -f "{{ .chezmoi.homeDir }}/.infisical/tailscale-authkey.txt" ]; then
      TS_AUTHKEY="$(cat "{{ .chezmoi.homeDir }}/.infisical/tailscale-authkey.txt" | tr -d '[:space:]')"
    fi
    if [[ -z "$TS_AUTHKEY" ]] && command -v infisical &>/dev/null; then
      TS_AUTHKEY="$(infisical run --env=dev --path=/ --project backend -- sh -c 'echo "$TAILSCALE_AUTHKEY_SERVER"' 2>/dev/null)" || true
    fi
    if [[ -n "$TS_AUTHKEY" ]]; then
      echo "→ Joining tailnet..."
      sudo tailscale up --authkey="$TS_AUTHKEY" --ssh --advertise-tags=tag:server
      echo "✓ Joined tailnet with Tailscale SSH enabled"
    else
      echo "⚠ Tailscale installed but no auth key available — run 'sudo tailscale up' manually"
    fi
{{- else }}
    echo "⚠ Tailscale installed but no secrets manager available — run 'sudo tailscale up' manually"
{{- end }}
  else
    echo "✓ Tailscale already connected"
  fi
fi
{{- end }}
