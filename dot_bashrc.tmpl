# Homebrew — interactive bash shells.
{{ template "brew-shellenv" . }}
{{ if eq .chezmoi.os "darwin" -}}
# postgresql@15 keg (macOS) — only if the keg is actually installed.
[ -n "$HOMEBREW_PREFIX" ] && [ -d "$HOMEBREW_PREFIX/opt/postgresql@15/bin" ] \
  && export PATH="$HOMEBREW_PREFIX/opt/postgresql@15/bin:$PATH"
{{ end }}
# Rust — guarded so a fresh machine without rustup doesn't error on every shell.
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
