# Core CLI stack — cross-platform essentials
# Used on both macOS and Linux (Docker, VPS, etc.)
#
# `brew bundle` only INSTALLS — it never removes packages that aren't listed.
# So this file defines what chezmoi auto-installs on a fresh machine.
# Anything you've brewed manually stays put.

brew "age"          # file encryption (used by chezmoi for secrets)
# ── CLI essentials ──────────────────────────────────────────────────────────
brew "bat"          # cat replacement
brew "direnv"       # auto-load .envrc per project
brew "doppler"              # secrets management (legacy — being replaced by infisical-agent)
# secrets management daemon (replaces doppler; agent renders secrets to files).
# macOS only: the infisical/get-cli tap is GoReleaser-generated and declares
# `depends_on :macos` with darwin-only download URLs, so on Linux `brew bundle`
# aborts with "This formula requires macOS" and takes the whole `chezmoi apply`
# down with it. Brewfiles are Ruby, so an OS guard is the supported way to say
# this. Linux hosts need the CLI from Infisical's apt/rpm repo instead — see
# .infisical/README.md.
brew "infisical/get-cli/infisical" if OS.mac?
brew "eza"          # ls replacement
brew "fd"           # find replacement (used by fzf)
brew "fnm"          # Node version manager
brew "fzf"          # fuzzy finder
brew "helix"        # text editor ($EDITOR)
brew "jq"           # JSON processor
brew "nnn"          # file manager
brew "powerlevel10k" # zsh prompt theme
brew "ripgrep"      # grep replacement
brew "uv"           # Python package manager
brew "zoxide"       # smarter cd (z / zi)
brew "lazyssh"
# ── Git tooling ─────────────────────────────────────────────────────────────
brew "git"
brew "gh"           # GitHub CLI
brew "git-filter-repo"
brew "lazygit"
# ── Language toolchains ─────────────────────────────────────────────────────
brew "go"
brew "pyenv"
# Rust is installed via the official rustup-init script (see
# run_once_after_install-toolchains.sh.tmpl) — Linuxbrew's rustup formula
# only ships the `rustup` binary without `cargo`/`rustc` proxies in
# ~/.cargo/bin, so we use the upstream installer for cross-platform parity.
