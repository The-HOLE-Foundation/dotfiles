#!/bin/bash
# Install Homebrew if missing (works on macOS and Linux).
#
# Alpine/musl is explicitly skipped: Homebrew's Linuxbrew binaries link
# against glibc and will not run on Alpine's musl libc. Core tools are
# installed via apk in run_once_after_install-brewfile.sh instead.
if command -v apk >/dev/null 2>&1; then
  echo "→ Alpine/musl detected — skipping Homebrew (incompatible with musl libc)"
  echo "  Core tools will be installed via apk in the brewfile step."
  exit 0
fi

if ! command -v brew &>/dev/null; then
  echo "→ Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Ensure brew is in PATH for subsequent scripts
{{- if eq .chezmoi.os "darwin" }}
eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null || eval "$(/usr/local/bin/brew shellenv)" 2>/dev/null
{{- else }}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)" 2>/dev/null
{{- end }}
