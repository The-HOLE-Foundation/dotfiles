#!/bin/bash
# Install Nix via the Determinate Systems installer if not already present.
# Docs: https://install.determinate.systems
#
# BEST-EFFORT BY DESIGN (dotfiles#117). This runs in the BEFORE phase, i.e. before
# chezmoi has deployed a single file. It used to run under a bare `set -e`, so any
# installer failure — no cached sudo credential, no TTY to prompt on, a network
# blip, an interrupted volume creation — aborted the *entire* apply. That is how
# the macOS deploy broke: Homebrew installed and journaled, this script exited
# non-zero, and nothing downstream ever ran. No dotfiles, no ~/.Brewfile.core, so
# no packages. A one-line stub ~/.zshrc for weeks.
#
# Nothing in the deploy needs Nix this early: the flake lives in the source dir
# and is consumed by run_once_after_nix-profile.sh, which sorts LAST in the after
# phase and carries its own identical installer as a safety net. So a failure here
# is genuinely recoverable — we warn and exit 0, and the after-phase script
# retries once the important things (shell config, Brewfile) are already on disk.
set -uo pipefail

{{- if not (index . "nix_profile") }}
exit 0
{{- end }}

if command -v nix &>/dev/null; then
  echo "  ✓ nix already installed ($(nix --version))"
  exit 0
fi

echo "→ Installing Nix (Determinate Systems)..."

{{- if eq .chezmoi.os "darwin" }}
# macOS: multi-user daemon required (SIP + sealed system volume)
if curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix \
  | sh -s -- install --no-confirm; then
{{- else }}
# Linux: daemon-less install for containers and VMs
if curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix \
  | sh -s -- install linux --no-confirm --init none; then
{{- end }}
  echo "  ✓ Nix installed"
else
  # Deliberately exit 0 — see the header. Aborting the before phase would block
  # every dotfile and the Brewfile from ever deploying.
  echo "  ⚠ Nix install failed (exit $?). Continuing — the deploy does not need"
  echo "    Nix this early, and run_once_after_nix-profile.sh will retry after"
  echo "    files and packages are in place."
fi

exit 0
